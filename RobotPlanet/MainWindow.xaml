<Window x:Class="RobotPlanet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Height="780" Width="900"
        MinHeight="780" MaxHeight="780"
        MinWidth="900" MaxWidth="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <CollectionViewSource x:Key="RobotsView"
                              Source="{Binding Robots}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="RobotType"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: список и добавление роботов -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,15,0">

            <StackPanel>
                <TextBlock x:Name="RobotsTitleText"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Поиск -->
                <TextBox Height="30"
                         Margin="0,0,0,8"
                         Padding="5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Сортировка и группировка -->
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="Nime järgi"
                            Margin="2" Height="30"
                            Command="{Binding SortNameCommand}"/>

                    <Button Content="Energia järgi"
                            Margin="2" Height="30"
                            Command="{Binding SortEnergyCommand}"/>

                    <Button Content="Grupeeri"
                            Margin="2" Height="30"
                            Command="{Binding GroupCommand}"/>

                    <Button Content="Näita kõiki"
                            Margin="2" Height="30"
                            Command="{Binding ShowAllCommand}"/>
                </UniformGrid>

                <!-- Список роботов -->
                <ListBox Height="220"
                         ItemsSource="{Binding Source={StaticResource RobotsView}}"
                         SelectedItem="{Binding SelectedRobot, Mode=TwoWay}">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               Margin="5,8,0,3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <!-- Количество роботов по типам -->
                <ItemsControl ItemsSource="{Binding GroupSummary}"
                              Margin="0,5,0,5"/>

                <!-- Имя нового робота -->
                <TextBox Height="30"
                         Margin="0,10,0,5"
                         Padding="5"
                         MaxLength="30"
                         Text="{Binding RobotName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Кнопки добавления и удаления -->
                <Button x:Name="AddCleanerButton"
                        Margin="0,10,0,5"
                        Height="35"
                        Command="{Binding AddCleanerCommand}"/>

                <Button x:Name="AddExplorerButton"
                        Margin="0,0,0,5"
                        Height="35"
                        Command="{Binding AddExplorerCommand}"/>

                <Button x:Name="AddRepairButton"
                        Margin="0,0,0,5"
                        Height="35"
                        Command="{Binding AddRepairCommand}"/>

                <Button x:Name="AddDanceButton"
                        Margin="0,0,0,5"
                        Height="35"
                        Command="{Binding AddDanceCommand}"/>

                <Button x:Name="RemoveButton"
                        Height="35"
                        Command="{Binding RemoveCommand}"/>
            </StackPanel>
        </Border>

        <!-- Правая часть: выбранный робот -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <StackPanel>
                <TextBlock x:Name="SelectedRobotTitleText"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedName, Mode=OneWay}"
                           FontSize="16"
                           Margin="0,10,0,15"/>

                <!-- Энергия -->
                <TextBlock x:Name="EnergyTitleText"
                           Margin="0,0,0,5"/>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding Energy, Mode=OneWay}"
                             Height="20"/>

                <TextBlock Text="{Binding EnergyText, Mode=OneWay}"
                           Margin="0,5,0,20"/>

                <!-- Действия робота -->
                <WrapPanel>
                    <Button x:Name="NormalButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Command="{Binding NormalCommand}"/>

                    <Button x:Name="CrazyButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Command="{Binding CrazyCommand}"/>

                    <Button x:Name="ChargeButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Command="{Binding ChargeCommand}"/>

                    <Button x:Name="ScanButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Command="{Binding ScanCommand}"/>
                </WrapPanel>

                <!-- Журнал действий -->
                <TextBlock x:Name="LogTitleText"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,15,0,10"/>

                <ListBox Height="250"
                         ItemsSource="{Binding Logs}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
