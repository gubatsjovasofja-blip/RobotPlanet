<Window x:Class="RobotPlanet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Width="1100"
        Height="780"
        MinWidth="850"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3FA">

    <Window.Resources>

        <!-- Värvid -->
        <SolidColorBrush x:Key="Purple" Color="#7454B8"/>
        <SolidColorBrush x:Key="DarkText" Color="#292438"/>
        <SolidColorBrush x:Key="MutedText" Color="#716B7E"/>

        <!-- Nupud -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#EEE9F7"/>
            <Setter Property="Foreground" Value="#49336F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Tekstiväljad -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#D8D1E5"/>
        </Style>

        <!-- Valikukastid -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#D8D1E5"/>
        </Style>

        <!-- Plokid -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#DDD5EA"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Vahekaardid -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,11"/>
        </Style>

    </Window.Resources>

    <DockPanel Margin="18">

        <!-- PEALKIRI -->
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,16">

            <TextBlock Text="Robot Planet"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource DarkText}"/>

            <TextBlock Text="Robotite haldamine, salvestamine ja arvutused"
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <!-- PÕHILISED VAHEKAARDID -->
        <TabControl Background="White"
                    BorderBrush="#DDD5EA"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- ================================= -->
            <!-- 1. ROBOTID -->
            <!-- ================================= -->

            <TabItem Header="Robotid">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="18">

                        <TextBlock Text="Robotite haldamine"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkText}"
                                   Margin="0,0,0,15"/>

                        <!-- ROBOTI VALIMINE -->
                        <GroupBox Header="Roboti valimine">

                            <StackPanel>

                                <TextBlock x:Name="RobotsTitleText"
                                           Visibility="Collapsed"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">

                                        <TextBlock Text="Roboti tüüp"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <ComboBox ItemsSource="{Binding RepositoryNames}"
                                                  SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,12,0">

                                        <TextBlock Text="Vali robot"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <ComboBox ItemsSource="{Binding Robots}"
                                                  SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Otsi nime järgi"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,15,0,0">

                                    <Button Content="Nime järgi"
                                            Command="{Binding SortNameCommand}"/>

                                    <Button Content="Energia järgi"
                                            Command="{Binding SortEnergyCommand}"/>

                                    <Button Content="Grupeeri"
                                            Command="{Binding GroupCommand}"/>

                                    <Button Content="Näita kõiki"
                                            Command="{Binding ShowAllCommand}"/>

                                </WrapPanel>

                                <ItemsControl ItemsSource="{Binding GroupSummary}"
                                              Margin="0,5,0,0"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- ROBOTI ANDMED JA LISAMINE -->
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- VALITUD ROBOT -->
                            <GroupBox Grid.Column="0"
                                      Header="Valitud robot">

                                <StackPanel>

                                    <TextBlock x:Name="SelectedRobotTitleText"
                                               Visibility="Collapsed"/>

                                    <TextBlock Text="{Binding SelectedName, Mode=OneWay}"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Purple}"
                                               Margin="0,0,0,12"/>

                                    <TextBlock x:Name="EnergyTitleText"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="18"
                                                 Value="{Binding Energy, Mode=OneWay}"
                                                 Foreground="#63B89A"
                                                 Background="#EAE5F0"/>

                                    <TextBlock Text="{Binding EnergyText, Mode=OneWay}"
                                               Foreground="{StaticResource MutedText}"
                                               Margin="0,6,0,15"/>

                                    <Separator Margin="0,0,0,14"/>

                                    <!-- RÜHMA MUUTMINE -->
                                    <TextBlock Text="Praegune rühm"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Text="{Binding SelectedGroup, Mode=OneWay}"
                                               Foreground="{StaticResource Purple}"
                                               FontSize="15"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Uus rühma nimi"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <TextBox Text="{Binding NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="100"
                                             Margin="0,0,0,10"/>

                                    <Button Content="Muuda gruppi"
                                            Background="#7454B8"
                                            Foreground="White"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ChangeGroupCommand}"/>

                                    <Separator Margin="0,12,0,14"/>

                                    <!-- TEGEVUSED -->
                                    <TextBlock Text="Roboti tegevused"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>

                                    <WrapPanel>

                                        <Button x:Name="NormalButton"
                                                Command="{Binding NormalCommand}"/>

                                        <Button x:Name="CrazyButton"
                                                Command="{Binding CrazyCommand}"/>

                                        <Button x:Name="ChargeButton"
                                                Command="{Binding ChargeCommand}"/>

                                        <Button x:Name="ScanButton"
                                                Command="{Binding ScanCommand}"/>

                                    </WrapPanel>

                                    <Button x:Name="RemoveButton"
                                            Content="Kustuta robot"
                                            Background="#FBE8EA"
                                            Foreground="#B13B4D"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Command="{Binding RemoveCommand}"/>

                                </StackPanel>
                            </GroupBox>

                            <!-- UUE ROBOTI LISAMINE -->
                            <GroupBox Grid.Column="2"
                                      Header="Lisa uus robot">

                                <StackPanel>

                                    <TextBlock Text="Roboti nimi"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <TextBox Text="{Binding RobotName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30"
                                             Margin="0,0,0,15"/>

                                    <TextBlock Text="Roboti tüüp"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <ComboBox x:Name="RobotTypeComboBox"
                                              SelectedIndex="0"
                                              Margin="0,0,0,15">

                                        <ComboBoxItem Content="CleanerBot"/>
                                        <ComboBoxItem Content="ExplorerBot"/>
                                        <ComboBoxItem Content="RepairBot"/>
                                        <ComboBoxItem Content="DanceBot"/>
                                        <ComboBoxItem Content="ChefBot"/>
                                        <ComboBoxItem Content="GuardBot"/>
                                        <ComboBoxItem Content="FlyingBot"/>

                                    </ComboBox>

                                    <Button Content="+ Lisa robot"
                                            Background="#7454B8"
                                            Foreground="White"
                                            HorizontalAlignment="Stretch"
                                            Click="AddRobotButton_Click"/>

                                    <Border Background="#F7F4FC"
                                            CornerRadius="8"
                                            Padding="15"
                                            Margin="0,20,0,0">

                                        <StackPanel>

                                            <TextBlock Text="Robotite maailm"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Purple}"
                                                       Margin="0,0,0,8"/>

                                            <TextBlock Text="Siin saad lisada roboteid, muuta nende rühmi ja kasutada erinevaid tegevusi."
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedText}"/>

                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </GroupBox>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================= -->
            <!-- 2. SALVESTAMINE -->
            <!-- ================================= -->

            <TabItem Header="Salvestamine">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,15">

                        <TextBlock Text="Maailma salvestamine"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkText}"/>

                        <TextBlock Text="Salvesta või taasta robotite maailm."
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- SALVESTAMISE VIISID -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- JSON -->
                        <GroupBox Grid.Column="0"
                                  Header="JSON">

                            <StackPanel>

                                <TextBlock Text="Salvesta maailm JSON-faili või laadi see tagasi."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,0,0,15"/>

                                <Button Content="Salvesta JSON"
                                        Background="#7454B8"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        Click="SaveJsonButton_Click"/>

                                <Button Content="Laadi JSON"
                                        HorizontalAlignment="Stretch"
                                        Click="LoadJsonButton_Click"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- XML -->
                        <GroupBox Grid.Column="2"
                                  Header="XML">

                            <StackPanel>

                                <TextBlock Text="Salvesta maailm XML-faili või laadi see tagasi."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,0,0,15"/>

                                <Button Content="Salvesta XML"
                                        Background="#7454B8"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        Click="SaveXmlButton_Click"/>

                                <Button Content="Laadi XML"
                                        HorizontalAlignment="Stretch"
                                        Click="LoadXmlButton_Click"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- LOCALDB -->
                        <GroupBox Grid.Column="4"
                                  Header="LocalDB">

                            <StackPanel>

                                <TextBlock Text="Salvesta maailm SQL Server LocalDB andmebaasi."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,0,0,15"/>

                                <Button Content="Salvesta LocalDB"
                                        Background="#7454B8"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        Click="SaveLocalDbButton_Click"/>

                                <Button Content="Laadi LocalDB"
                                        HorizontalAlignment="Stretch"
                                        Click="LoadLocalDbButton_Click"/>

                            </StackPanel>
                        </GroupBox>

                    </Grid>

                    <!-- TEGEVUSTE AJALUGU -->
                    <GroupBox Grid.Row="2"
                              Header="Tegevuste ajalugu"
                              Margin="0,12,0,0">

                        <DockPanel>

                            <TextBlock x:Name="LogTitleText"
                                       Visibility="Collapsed"/>

                            <ListBox ItemsSource="{Binding Logs}"
                                     BorderBrush="#DDD5EA"/>

                        </DockPanel>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- ================================= -->
            <!-- 3. ARVUTUSED -->
            <!-- ================================= -->

            <TabItem x:Name="CalculationsTab"
                     Header="Arvutused">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="18">

                        <TextBlock Text="Robotite arvutused"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkText}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Vali robotid, määra töömaht ja käivita arvutused."
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,0,0,15"/>

                        <!-- ROBOTITE VALIK -->
                        <GroupBox Header="1. Vali robotid">

                            <StackPanel>

                                <TextBlock Text="Vali vähemalt 3 robotit."
                                           Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Robots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Border Background="#F5F2FA"
                                                    BorderBrush="#E2D9EF"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,10,10"
                                                    MinWidth="180">

                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- ARVUTAMISE SEADED -->
                        <GroupBox Header="2. Arvutamise seaded">

                            <StackPanel>

                                <TextBlock Text="Töömaht (operatsioonide arv)"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox Width="220"
                                         HorizontalAlignment="Left"
                                         Text="{Binding WorkAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,12"/>

                                <WrapPanel>

                                    <Button Content="Järjestikune"
                                            Width="150"
                                            Click="SequentialButton_Click"/>

                                    <Button Content="Paralleelne"
                                            Width="150"
                                            Click="ParallelButton_Click"/>

                                    <Button Content="Tühista"
                                            Width="120"
                                            Background="#FBE8EA"
                                            Foreground="#B13B4D"
                                            Click="CancelButton_Click"/>

                                </WrapPanel>

                                <TextBlock Text="{Binding Message, Mode=OneWay}"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedText}"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- TULEMUSED -->
                        <GroupBox Header="3. Arvutuste tulemused">

                            <StackPanel>

                                <TextBlock Text="{Binding TotalTime, Mode=OneWay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Purple}"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Comparison, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="#7454B8"
                                           Margin="0,8,0,10"/>

                                <DataGrid ItemsSource="{Binding Results}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="230"
                                          RowHeight="32"
                                          BorderBrush="#DDD5EA">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Robot"
                                                            Binding="{Binding RobotName}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Tüüp"
                                                            Binding="{Binding RobotType}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Tulemus"
                                                            Binding="{Binding Result}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Staatus"
                                                            Binding="{Binding Status}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Aeg (ms)"
                                                            Binding="{Binding TimeMs}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Viga"
                                                            Binding="{Binding Error}"
                                                            Width="2*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
