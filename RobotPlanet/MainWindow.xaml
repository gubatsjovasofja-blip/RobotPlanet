<Window x:Class="RobotPlanet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Width="1100" Height="780"
        MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3FA">

    <Window.Resources>

        <SolidColorBrush x:Key="Purple" Color="#7454B8"/>
        <SolidColorBrush x:Key="DarkText" Color="#292438"/>
        <SolidColorBrush x:Key="MutedText" Color="#716B7E"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#EEE9F7"/>
            <Setter Property="Foreground" Value="#49336F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,0,7,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#D8D1E5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#D8D1E5"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#DDD5EA"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

    </Window.Resources>

    <DockPanel Margin="15">

        <!-- Pealkiri -->
        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,12">

            <TextBlock Text="Robot Planet"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="{StaticResource DarkText}"/>

            <TextBlock Text="Robotite haldamine ja arvutused"
                       Foreground="{StaticResource MutedText}"/>
        </StackPanel>

        <TabControl Background="White"
                    BorderBrush="#DDD5EA"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- ROBOTID -->
            <TabItem Header="Robotid">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ROBOTI VALIMINE -->
                    <GroupBox Grid.Row="0"
                              Header="1. Roboti valimine">

                        <StackPanel>

                            <TextBlock x:Name="RobotsTitleText"
                                       Visibility="Collapsed"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0">

                                    <TextBlock Text="Roboti tüüp"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>

                                    <ComboBox ItemsSource="{Binding RepositoryNames}"
                                              SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,12,0">

                                    <TextBlock Text="Vali robot"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>

                                    <ComboBox ItemsSource="{Binding Robots}"
                                              SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                                              DisplayMemberPath="Name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="Otsi nime järgi"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>

                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">

                                <Button Content="Nime järgi"
                                        Command="{Binding SortNameCommand}"/>

                                <Button Content="Energia järgi"
                                        Command="{Binding SortEnergyCommand}"/>

                                <Button Content="Grupeeri"
                                        Command="{Binding GroupCommand}"/>

                                <Button Content="Näita kõiki"
                                        Command="{Binding ShowAllCommand}"/>

                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding GroupSummary}"
                                          Margin="0,3,0,0"/>

                        </StackPanel>
                    </GroupBox>

                    <!-- ROBOTI ANDMED JA LISAMINE -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Valitud robot -->
                        <GroupBox Grid.Column="0"
                                  Header="2. Valitud robot"
                                  Margin="0,0,10,10">

                            <StackPanel>

                                <TextBlock x:Name="SelectedRobotTitleText"
                                           Visibility="Collapsed"/>

                                <TextBlock Text="{Binding SelectedName, Mode=OneWay}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Purple}"
                                           Margin="0,0,0,12"/>

                                <TextBlock x:Name="EnergyTitleText"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="17"
                                             Value="{Binding Energy, Mode=OneWay}"
                                             Foreground="#63B89A"
                                             Background="#EAE5F0"/>

                                <TextBlock Text="{Binding EnergyText, Mode=OneWay}"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="Roboti tegevused"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <WrapPanel>

                                    <Button x:Name="NormalButton"
                                            Command="{Binding NormalCommand}"/>

                                    <Button x:Name="CrazyButton"
                                            Command="{Binding CrazyCommand}"/>

                                    <Button x:Name="ChargeButton"
                                            Command="{Binding ChargeCommand}"/>

                                    <Button x:Name="ScanButton"
                                            Command="{Binding ScanCommand}"/>

                                </WrapPanel>

                                <Button x:Name="RemoveButton"
                                        Content="Kustuta robot"
                                        HorizontalAlignment="Left"
                                        Background="#FBE8EA"
                                        Foreground="#B13B4D"
                                        Margin="0,5,0,0"
                                        Command="{Binding RemoveCommand}"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- Uue roboti lisamine -->
                        <GroupBox Grid.Column="1"
                                  Header="3. Lisa uus robot">

                            <StackPanel>

                                <TextBlock Text="Roboti nimi"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding RobotName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30"
                                         Margin="0,0,0,12"/>

                                <TextBlock Text="Roboti tüüp"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="RobotTypeComboBox"
                                          SelectedIndex="0"
                                          Margin="0,0,0,12">

                                    <ComboBoxItem Content="CleanerBot"/>
                                    <ComboBoxItem Content="ExplorerBot"/>
                                    <ComboBoxItem Content="RepairBot"/>
                                    <ComboBoxItem Content="DanceBot"/>
                                    <ComboBoxItem Content="ChefBot"/>
                                    <ComboBoxItem Content="GuardBot"/>
                                    <ComboBoxItem Content="FlyingBot"/>

                                </ComboBox>

                                <Button Content="+ Lisa robot"
                                        Background="#7454B8"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        Click="AddRobotButton_Click"/>

                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <!-- TEGEVUSTE LOGI -->
                    <GroupBox Grid.Row="2"
                              Header="4. Tegevuste ajalugu">

                        <DockPanel>

                            <TextBlock x:Name="LogTitleText"
                                       Visibility="Collapsed"/>

                            <ListBox ItemsSource="{Binding Logs}"
                                     BorderBrush="#DDD5EA"/>

                        </DockPanel>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- ARVUTUSED -->
            <TabItem x:Name="CalculationsTab"
                     Header="Arvutused">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="18">

                        <TextBlock Text="Robotite arvutused"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkText}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Vali robotid, määra töömaht ja käivita arvutused."
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,0,0,15"/>

                        <!-- Robotite valik -->
                        <GroupBox Header="1. Vali robotid">

                            <StackPanel>

                                <TextBlock Text="Vali vähemalt 3 robotit."
                                           Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Robots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Border Background="#F5F2FA"
                                                    BorderBrush="#E2D9EF"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,10,10"
                                                    MinWidth="180">

                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </GroupBox>

                        <!-- Arvutamise seaded -->
                        <GroupBox Header="2. Arvutamise seaded">

                            <StackPanel>

                                <TextBlock Text="Töömaht (operatsioonide arv)"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox Width="220"
                                         HorizontalAlignment="Left"
                                         Text="{Binding WorkAmount, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,12"/>

                                <WrapPanel>

                                    <Button Content="Järjestikune"
                                            Width="150"
                                            Click="SequentialButton_Click"/>

                                    <Button Content="Paralleelne"
                                            Width="150"
                                            Click="ParallelButton_Click"/>

                                    <Button Content="Tühista"
                                            Width="120"
                                            Background="#FBE8EA"
                                            Foreground="#B13B4D"
                                            Click="CancelButton_Click"/>

                                </WrapPanel>

                                <TextBlock Text="{Binding Message}"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedText}"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- Tulemused -->
                        <GroupBox Header="3. Arvutuste tulemused">

                            <StackPanel>

                                <TextBlock Text="{Binding TotalTime}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Purple}"
                                           Margin="0,0,0,10"/>

                                <!-- Kahe režiimi võrdlus -->
                                <TextBlock Text="{Binding Comparison}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="#7454B8"
                                           Margin="0,8,0,10"/>  

                                <DataGrid ItemsSource="{Binding Results}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="230"
                                          RowHeight="32"
                                          BorderBrush="#DDD5EA">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Robot"
                                                            Binding="{Binding RobotName}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Tüüp"
                                                            Binding="{Binding RobotType}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Tulemus"
                                                            Binding="{Binding Result}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Staatus"
                                                            Binding="{Binding Status}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Aeg (ms)"
                                                            Binding="{Binding TimeMs}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Viga"
                                                            Binding="{Binding Error}"
                                                            Width="2*"/>

                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
