<Window x:Class="RobotPlanet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Height="680" Width="850"
        MinHeight="680" MaxHeight="680"
        MinWidth="850" MaxWidth="850"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">   


    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Vasak pool -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,15,0">

            <StackPanel>
                <TextBlock x:Name="RobotsTitleText"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <ListBox x:Name="RobotList"
                         Height="250"
                         SelectionChanged="RobotList_SelectionChanged"/>

                <TextBox x:Name="RobotNameTextBox"
                        Height="30"
                        Margin="0,10,0,5"
                        Padding="5"
                        MaxLength="30"/>


                <Button x:Name="AddCleanerButton"
                        Margin="0,15,0,5"
                        Height="35"
                        Click="AddCleaner_Click"/>

                <Button x:Name="AddExplorerButton"
                        Margin="0,0,0,5"
                        Height="35"
                        Click="AddExplorer_Click"/>

                <Button x:Name="AddRepairButton"
                        Margin="0,0,0,5"
                        Height="35"
                        Click="AddRepair_Click"/>

                <Button x:Name="RemoveButton"
                        Height="35"
                        Click="Remove_Click"/>
            </StackPanel>
        </Border>

        <!-- Parem pool -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <StackPanel>
                <TextBlock x:Name="SelectedRobotTitleText"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SelectedRobotText"
                           FontSize="16"
                           Margin="0,10,0,15"/>

                <TextBlock x:Name="EnergyTitleText"
                           Margin="0,0,0,5"/>

                <ProgressBar x:Name="EnergyBar"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Height="20"/>

                <TextBlock x:Name="EnergyText"
                           Margin="0,5,0,20"/>

                <WrapPanel>
                    <Button x:Name="NormalButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Click="Normal_Click"/>

                    <Button x:Name="CrazyButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Click="Crazy_Click"/>

                    <Button x:Name="ChargeButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Click="Charge_Click"/>

                    <Button x:Name="ScanButton"
                            Width="110" Height="35"
                            Margin="0,0,10,10"
                            Click="Scan_Click"/>
                </WrapPanel>

                <TextBlock x:Name="LogTitleText"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,15,0,10"/>

                <ListBox x:Name="LogList"
                         Height="180"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

